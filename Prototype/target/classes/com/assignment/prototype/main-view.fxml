<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.assignment.prototype.Controller">
   <left>
      <VBox prefHeight="100.0" prefWidth="100.0" spacing="5.0" BorderPane.alignment="CENTER">
         <children>
            <ListView fx:id="recommendationList" prefHeight="300.0" prefWidth="100.0" />
            <Label text="Target Audience">
               <VBox.margin>
                  <Insets left="10.0" />
               </VBox.margin>
            </Label>
            <TextField fx:id="targetAudienceField" maxHeight="-Infinity" maxWidth="-Infinity" prefHeight="25.0" prefWidth="147.0" promptText="Target Audience">
               <VBox.margin>
                  <Insets left="10.0" />
               </VBox.margin></TextField>
            <ButtonBar prefHeight="40.0" prefWidth="200.0">
              <buttons>
                  <Button mnemonicParsing="false" onAction="#handleCreateList" text="Create" />
                <Button minWidth="68.0" mnemonicParsing="false" onAction="#handleClone" prefHeight="25.0" prefWidth="50.0" text="Clone" />
              </buttons>
               <VBox.margin>
                  <Insets right="10.0" />
               </VBox.margin>
            </ButtonBar>
         </children>
      </VBox>
   </left>
   <right>
      <VBox prefHeight="200.0" prefWidth="100.0" spacing="10.0" BorderPane.alignment="CENTER">
         <children>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label prefHeight="35.0" prefWidth="73.0" text="Author">
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </Label>
                  <TextField fx:id="authorField" prefHeight="35.0" prefWidth="120.0" promptText="Author">
                     <HBox.margin>
                        <Insets right="5.0" />
                     </HBox.margin>
                  </TextField>
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label prefHeight="35.0" prefWidth="73.0" text="Title">
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </Label>
                  <TextField fx:id="titleField" prefHeight="35.0" prefWidth="120.0" promptText="Title">
                     <HBox.margin>
                        <Insets right="5.0" />
                     </HBox.margin></TextField>
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label prefHeight="35.0" prefWidth="73.0" text="Genre">
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </Label>
                  <TextField fx:id="genreField" prefHeight="35.0" prefWidth="120.0" promptText="Genre">
                     <HBox.margin>
                        <Insets right="5.0" />
                     </HBox.margin></TextField>
               </children>
            </HBox>
            <HBox alignment="CENTER" prefHeight="100.0" prefWidth="200.0">
               <children>
                  <Label prefHeight="35.0" prefWidth="73.0" text="Year">
                     <padding>
                        <Insets left="10.0" />
                     </padding>
                  </Label>
                  <TextField fx:id="yearField" prefHeight="35.0" prefWidth="120.0" promptText="Year">
                     <HBox.margin>
                        <Insets right="5.0" />
                     </HBox.margin></TextField>
               </children>
            </HBox>
            <ButtonBar prefHeight="40.0" prefWidth="200.0">
              <buttons>
                  <Button alignment="CENTER" mnemonicParsing="false" onAction="#handleRemoveBook" text="Remove" />
                <Button alignment="CENTER" mnemonicParsing="false" onAction="#handleAddBook" text="Add" />
              </buttons>
               <VBox.margin>
                  <Insets bottom="5.0" right="10.0" />
               </VBox.margin>
            </ButtonBar>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </VBox>
   </right>
   <center>
      <ListView fx:id="bookList" prefHeight="350.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
   </center>
</BorderPane>
